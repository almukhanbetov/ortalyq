# Скопируйте в .env и замените значения. Не коммитьте .env.
# Сгенерировать секреты: openssl rand -hex 32

# --- База данных ---
POSTGRES_PASSWORD=change-me-postgres
# Для запуска бэкенда вне Docker (режим разработки):
DATABASE_URL=postgres://ortalyq:change-me-postgres@127.0.0.1:55432/ortalyq?sslmode=disable

# --- Приложение ---
# Не короче 32 символов: подпись временных ссылок на файлы и токенов шаблона записи
APP_SECRET=replace-with-output-of-openssl-rand-hex-32
# Адреса, с которых открывают сайт (через запятую). Для телефона добавьте https://<IP-компьютера>:8443
PUBLIC_ORIGINS=https://localhost:8443,http://localhost:13000
# true, если сайт открывается только по HTTPS
COOKIE_SECURE=false
# Пароль демо-аккаунтов (команда seed). Только для локальной демонстрации.
DEMO_PASSWORD=
# Пароль администратора задаётся только при запуске create-admin, не храните его здесь.

# --- HTTPS-прокси Caddy ---
# Список адресов сайта. Для телефона в локальной сети: https://localhost:8443, https://192.168.1.10:8443
SITE_ADDRESSES=https://localhost:8443

# --- LiveKit (видеосвязь) ---
# Self-hosted (docker compose): придумайте ключ и секрет (секрет не короче 32 символов).
# LiveKit Cloud: возьмите из проекта на cloud.livekit.io.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# IP компьютера в локальной сети, который увидят браузеры (для телефона обязательно LAN-IP)
LIVEKIT_NODE_IP=127.0.0.1
# URL LiveKit для бэкенда (только для запуска бэкенда вне Docker)
LIVEKIT_URL=http://127.0.0.1:7880
# URL LiveKit для браузера. Пусто — браузер подключается к wss://<адрес сайта>/rtc через Caddy.
# В режиме разработки на одном компьютере: ws://localhost:7880. Для LiveKit Cloud: wss://<project>.livekit.cloud
LIVEKIT_PUBLIC_URL=

# --- Запись занятий (LiveKit Egress) ---
RECORDING_ENABLED=true
# Адрес фронтенда, который откроет headless Chrome сервиса Egress (из сети хоста)
RECORDING_TEMPLATE_BASE_URL=http://127.0.0.1:13000

# --- S3-совместимое хранилище ---
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ortalyq-private
# Для бэкенда вне Docker (host:port без схемы):
S3_ENDPOINT=127.0.0.1:19000
S3_USE_SSL=false
S3_REGION=us-east-1
# Адрес S3 для сервиса Egress (со схемой)
EGRESS_S3_ENDPOINT=http://127.0.0.1:19000

MAX_UPLOAD_MB=20
# За сколько минут до начала открывается вход в класс. Закрывается вход ровно в момент окончания урока
# (опоздание не продлевает занятие).
JOIN_EARLY_MINUTES=15

# Часовой пояс по умолчанию для новых пользователей — Asia/Almaty (время в БД хранится в UTC).
# Валюта — тенге (KZT, ₸); суммы хранятся целыми тенге.

# --- Исполнитель кода (вкладка «Код» в классе) ---
# Отдельный изолированный сервер Judge0 CE (не на сервере приложения!) — см. docs/CODE_RUNNER.md.
# Пусто — совместное редактирование работает, запуск показывает «Сервис выполнения не настроен».
CODE_RUNNER_URL=
# Значение AUTHN_TOKEN из judge0.conf исполнителя (серверный секрет, в браузер не передаётся)
CODE_RUNNER_TOKEN=
# language_id Python 3 в Judge0 (проверьте GET /languages вашего исполнителя; в CE 1.13.1 — 71, Python 3.8.1)
CODE_RUNNER_PYTHON_ID=71
# Ограничения одного запуска
CODE_RUN_CPU_SECONDS=2
CODE_RUN_WALL_SECONDS=5
CODE_RUN_MEMORY_MB=128
CODE_RUN_MAX_CONCURRENT=4

# --- ИИ «Учебной мастерской» (OpenAI Responses API) ---
# Ключ — только серверный секрет: в браузер, логи и репозиторий не попадает. Пусто — совместный текст,
# разборы и задания работают, а кнопки ИИ показывают «ИИ не настроен». Фиктивных ответов нет.
OPENAI_API_KEY=
# Модель обязательна (актуальный список — https://developers.openai.com/api/docs/models)
OPENAI_MODEL=
# Необязательно:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_REASONING_EFFORT=low        # только для моделей с рассуждением
# OPENAI_TIMEOUT_SECONDS=60          # не больше 100 (прокси ждёт ответа до 120 с)
# OPENAI_MAX_OUTPUT_TOKENS=4000      # длина ответа, включая токены рассуждения
# WORKSHOP_AI_PER_MINUTE=6           # запросов в минуту на преподавателя
# WORKSHOP_AI_PER_HOUR=40            # запросов в час на урок

# Пробный урок (/demo): демонстрация класса без регистрации, docs/TRIAL.md. Значения по умолчанию:
# DEMO_ENABLED=true
# DEMO_MINUTES=15                    # длительность по серверному времени (1–60)
# DEMO_MAX_ACTIVE=30                 # одновременно идущих демонстраций на сервер
# DEMO_PER_IP_PER_HOUR=6             # новых демонстраций с одного IP в час (и не больше 3 в минуту)
# DEMO_CODE_RUNS=20                  # запусков кода на одну демонстрацию; 0 — запуск в демо выключен
# DEMO_RETENTION_HOURS=24            # через сколько часов после окончания удаляются служебные записи

# Доверенные прокси (IP или CIDR через запятую): только от них бэкенд принимает адрес клиента из
# X-Forwarded-For / X-Real-IP. От остальных — адрес соединения. По умолчанию 127.0.0.1,::1 (dev-прокси Next.js).
# Доверие всем (0.0.0.0/0, «*») не допускается. На VPS задаётся deploy/k8s/scripts/set-trusted-proxy.sh.
# TRUSTED_PROXIES=127.0.0.1,::1
